{
  "name": "@luvikung/three-next",
  "version": "1.3.1",
  "description": "A lightweight React/Next.js integration layer for Three.js. Manages the WebGL renderer lifecycle, animation loop, resize handling, WebGL context loss/restoration, and error boundaries.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.184.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuviKunG/three-next.git"
  },
  "homepage": "https://github.com/LuviKunG/three-next#readme",
  "bugs": {
    "url": "https://github.com/LuviKunG/three-next/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "react",
    "nextjs",
    "webgl",
    "3d",
    "canvas"
  ],
  "license": "MIT",
  "author": "Thanut Panichyotai"
}
